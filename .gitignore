# Ignore everything by default
*

# Keep essential source files
!src/
!src/**/*

# Keep public assets (except OS files)
!public/
public/.DS_Store

# Keep entry point
!index.html

# Keep build configs
!package.json
!package-lock.json
!vite.config.ts
!tailwind.config.js
!postcss.config.js
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!eslint.config.js

# Keep documentation
!README.md

# Standard exclusions (generated files)
src/.DS_Store
node_modules/
dist/
dist-ssr/
*.local
.env
.env.*
.DS_Store
Thumbs.db
*.log
logs/
